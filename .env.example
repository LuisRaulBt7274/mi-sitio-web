# =============================================================================
# GitHub MCP Server
# =============================================================================
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user, read:org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Google OAuth 2.0 Configuration
# =============================================================================
# Step 1: Go to https://console.cloud.google.com/apis/credentials
# Step 2: Create OAuth 2.0 Client ID credentials
# Step 3: Set redirect URIs: http://localhost:3000/callback
# Step 4: Download JSON and extract values below

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/callback

# =============================================================================
# Google OAuth Scopes (space-separated)
# =============================================================================
# Gmail: https://mail.google.com/ https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send
# Drive: https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file
# Calendar: https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.readonly
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file https://mail.google.com/ https://www.googleapis.com/auth/calendar.events

# =============================================================================
# Slack OAuth 2.0 Configuration
# =============================================================================
# Step 1: Create app at https://api.slack.com/apps
# Step 2: Configure OAuth Redirect URLs: https://yourdomain.com/oauth_redirect
# Step 3: Install app to workspace
# Step 4: Copy Bot User OAuth Token from "OAuth & Permissions"

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_TEAM_ID=T0123456789